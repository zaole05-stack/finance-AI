# Kopieren nach .env und ausfüllen. .env wird nicht committet.

# Die SEC verlangt bei automatischen Abrufen einen Namen und eine Kontaktadresse.
SEC_USER_AGENT="Vorname Nachname name@example.org"

# Ziel der täglichen Backups (BEREICH-A.md, Beschluss 8), z. B. ein OneDrive-Ordner.
# Die laufende Datenbank selbst gehört nicht in OneDrive.
# FINANCE_AI_BACKUP_DIR="C:/Users/<name>/OneDrive/finance-ai-backups"
